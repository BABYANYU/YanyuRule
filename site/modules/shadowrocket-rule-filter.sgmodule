[Script]
YanyuRule Filter = type=http-request,pattern=^https:\/\/yanyu\.rule\/Shadowrocket\/list\?,script-path=https://rule.fakeyou.eu.org/modules/client-rule-filter.js,timeout=30,engine=webview

[MITM]
hostname = %APPEND% yanyu.rule
